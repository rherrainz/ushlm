DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-only-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL: set all PG variables and DATABASE_ENGINE=postgresql
DATABASE_ENGINE=sqlite
PGDATABASE=ushlm
PGUSER=ushlm
PGPASSWORD=replace-me
PGHOST=localhost
PGPORT=5432

# Neon / Vercel: set these in the Vercel dashboard, never commit real values.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=your-project.vercel.app,ush-lm.ar
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://ush-lm.ar
# VERCEL=1 is supplied by Vercel; do not set it for ordinary local development.

# Private daily backup (Production only; never paste real keys here).
DAILY_BACKUP_ENABLED=0
# CRON_SECRET=
# BACKUP_ENCRYPTION_KEY=
# BLOB_STORE_ID=
